# Global security headers and cache control
# NOTE: per-route HTML `Cache-Control` entries are appended to the BUILT copy
# (dist/client/_headers) by scripts/append-html-headers.js during postbuild.
# Do not list prerendered routes here — they are only known after SSG crawl.
# See docs/ARCHITECTURE.md (SSG + caching) and docs/CODING_STANDARDS.md §19.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.cloudflare.com https://*.cloudflareinsights.com data:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://images.higgs.ai https://*.cloudfront.net; connect-src 'self' https://*.cloudflare.com https://*.cloudflareinsights.com https://api.open-meteo.com; frame-ancestors 'none'; upgrade-insecure-requests;
  Cache-Control: public, max-age=0, must-revalidate

# JS/CSS: 1 year immutable (hashed filenames safe)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# CSS: must-revalidate so updates apply instantly
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate

# Fonts: 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images/Media: 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Flowers (hero) - 1 year immutable
/flowers/*
  Cache-Control: public, max-age=31536000, immutable

# Logo (LCP hero)
/logo.svg
  Cache-Control: public, max-age=31536000, immutable

/logo-dark.svg
  Cache-Control: public, max-age=31536000, immutable

# Favicons
/favicon.*
  Cache-Control: public, max-age=31536000, immutable

/icon-*
  Cache-Control: public, max-age=31536000, immutable